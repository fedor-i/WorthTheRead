# Required for the judge path (verify_claim / score_answer).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# WYR_MODEL=claude-sonnet-5-5          # flip to a stronger model for hard cases
# WYR_CONTACT_EMAIL=you@example.com    # enables Crossref/NCBI "polite pools" + Unpaywall
# WYR_HTTP_TIMEOUT=20
# WYR_MAX_TEXT_CHARS=48000

# Optional free full-text API keys (expand green/repository + publisher-OA coverage).
# WYR_CORE_API_KEY=...                 # free: register at core.ac.uk/services/api
# WYR_S2_API_KEY=...                   # free: semanticscholar.org/product/api
# WYR_SPRINGER_API_KEY=...             # free: dev.springernature.com (Springer/Nature/BMC OA)
# WYR_ELSEVIER_API_KEY=...             # free: dev.elsevier.com (Elsevier OA full text)
# WYR_ELSEVIER_INSTTOKEN=...           # optional: unlocks subscription content you're entitled to
